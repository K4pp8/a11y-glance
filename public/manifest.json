{
  "manifest_version": 3,
  "name": "A11y Glance",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Find accessibility issues, inspect elements, and export focused Markdown reports. Runs locally, on your click.",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "action": {
    "default_title": "Inspect accessibility with A11y Glance",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
